# =================================================================
# Pink Hope - Breast Cancer Awareness Web Application
# Environment Configuration Template
# (Copy this file to .env and fill in your production credentials)
# =================================================================

# Server Port
PORT=5001

# Frontend API URL (Set to your deployed backend domain in production, e.g. https://your-backend.onrender.com/api)
VITE_API_URL=http://localhost:5001/api

# -----------------------------------------------------------------
# 1. META WHATSAPP CLOUD API (Official Meta Graph API)
# -----------------------------------------------------------------
# Obtain these from developers.facebook.com -> Your App -> WhatsApp -> API Setup
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=
# Optional approved template name (default: pink_hope_greeting)
META_WA_TEMPLATE_NAME=pink_hope_greeting

# -----------------------------------------------------------------
# 2. EMAIL SMTP (Nodemailer - Gmail / Resend / AWS SES / SendGrid)
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pink Hope Awareness <awareness@sgpgibreasthealth.org.in>"

# -----------------------------------------------------------------
# 3. OPTIONAL: TWILIO (Alternative SMS / WhatsApp provider)
# -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
