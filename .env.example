# =================================================================
# Pink Hope - Breast Cancer Awareness Web Application
# Environment Configuration Template
# =================================================================

# Server Port
PORT=5001

# Owner reporting (keep this secret; use it as the Bearer token in #owner-report)
ADMIN_REPORT_TOKEN=replace-with-a-long-random-owner-token
# Optional persistent path for the anonymous report store
# REPORT_DATA_FILE=./server/message-report.json

# Frontend API URL (Set to your deployed backend domain in production, e.g. https://can-xxxx.onrender.com/api)
VITE_API_URL=http://localhost:5001/api

# -----------------------------------------------------------------
# 1. TWILIO WHATSAPP & SMS API
# -----------------------------------------------------------------
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# For WhatsApp: '+14155238886' for Twilio Sandbox, or your Twilio WhatsApp number
TWILIO_WHATSAPP_NUMBER=+14155238886

# Public HTTPS origin of this Render app (no trailing slash). Twilio fetches card images from here.
PUBLIC_APP_URL=https://your-app.onrender.com

# Keep false to send session messages (recipient messaged you in the last 24 hours) with the generated card image.
TWILIO_USE_TEMPLATE=false

# Later: Meta-approved Twilio Content Template SID (starts with HX) + TWILIO_USE_TEMPLATE=true
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Messaging Service that includes the WhatsApp sender
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Map these to the {{n}} placeholders in YOUR approved template (omit unused ones).
# If the template media field is https://your-app.onrender.com/{{1}}, set MEDIA=1
TWILIO_CONTENT_VAR_MEDIA=1
TWILIO_CONTENT_VAR_RECIPIENT=2
TWILIO_CONTENT_VAR_SENDER=3
TWILIO_CONTENT_VAR_MESSAGE=4
# TWILIO_CONTENT_VAR_RELATIONSHIP=5

# Set true only if your template variable expects a full https:// URL instead of temp_uploads/file.png
TWILIO_CONTENT_MEDIA_FULL_URL=false

# For SMS: Your Twilio phone number
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------
# 2. TWILIO SENDGRID EMAIL API (Official HTTPS REST API - 100 emails/day free)
# -----------------------------------------------------------------
# Get API Key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your verified Single Sender email address on SendGrid (Settings -> Sender Authentication)
SENDGRID_FROM_EMAIL=your-verified-email@gmail.com
