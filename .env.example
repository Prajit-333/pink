# =================================================================
# Pink Hope - Breast Cancer Awareness Web Application
# Environment Configuration Template
# =================================================================

# Server Port
PORT=5001

# Frontend API URL (Set to your deployed backend domain in production, e.g. https://can-xxxx.onrender.com/api)
VITE_API_URL=http://localhost:5001/api

# -----------------------------------------------------------------
# 1. TWILIO API (WhatsApp & SMS)
# -----------------------------------------------------------------
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# For WhatsApp: Use '+14155238886' for free Twilio Sandbox, or your Twilio WhatsApp number
TWILIO_WHATSAPP_NUMBER=+14155238886

# For SMS: Your Twilio phone number
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------
# 2. EMAIL SMTP (Nodemailer - Gmail / Resend / AWS SES / SendGrid)
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Pink Hope Awareness <awareness@sgpgibreasthealth.org.in>"
